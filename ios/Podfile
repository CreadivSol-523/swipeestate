# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'swipeestate' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Pods: deployment target 15.1 aur explicit modules band
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        current = build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if current.nil? || Gem::Version.new(current.to_s) < Gem::Version.new('15.1')
          build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        end
        build_config.build_settings['SWIFT_ENABLE_EXPLICIT_MODULES'] = 'NO'
        build_config.build_settings['CLANG_ENABLE_EXPLICIT_MODULES'] = 'NO'
      end
    end

    # App target par bhi explicit modules band
    installer.aggregate_targets.each do |agg|
      agg.user_project.native_targets.each do |target|
        target.build_configurations.each do |build_config|
          build_config.build_settings['SWIFT_ENABLE_EXPLICIT_MODULES'] = 'NO'
          build_config.build_settings['CLANG_ENABLE_EXPLICIT_MODULES'] = 'NO'
        end
      end
      agg.user_project.save
    end

    # Naye Xcode ke saath fmt ka consteval error: header mein hi consteval band karo
    ['base.h', 'format.h'].each do |header|
      path = File.join(installer.sandbox.root.to_s, 'fmt', 'include', 'fmt', header)
      next unless File.exist?(path)
      File.chmod(0644, path)
      text = File.read(path)
      patched = text.gsub(/(#\s*define FMT_USE_CONSTEVAL) 1/, '\1 0')
      if patched != text
        File.write(path, patched)
        Pod::UI.puts "Patched #{header}: FMT_USE_CONSTEVAL set to 0"
      end
    end
  end
end
